#cloud-config
users:
  - name: admincoop
    sudo: ALL=(ALL) NOPASSWD:ALL
    groups: users, admin
    shell: /bin/bash
    lock_passwd: false
    plain_text_passwd: 'smxcoop2026'

ssh_pwauth: true

packages:
  - nftables
  - dnsmasq
  - tcpdump

write_files:
  - path: /etc/sysctl.d/99-ipforward.conf
    content: |
      net.ipv4.ip_forward=1
  - path: /etc/nftables.conf
    content: |
      #!/usr/sbin/nft -f
      flush ruleset

      table inet filter {
        chain input {
          type filter hook input priority 0; policy drop;
          iif "lo" accept
          ct state established,related accept
          icmp type echo-request accept
          # SSH permitido desde WAN (host) y desde VLAN 10 (MGMT)
          iifname { "enp1s0", "enp2s0" } tcp dport 22 accept
          # DNS/DHCP hacia el router desde las VLANs internas
          iifname { "enp2s0", "enp3s0", "enp4s0", "enp5s0" } udp dport { 53, 67 } accept
          iifname { "enp2s0", "enp3s0", "enp4s0", "enp5s0" } tcp dport 53 accept
        }

        chain forward {
          type filter hook forward priority 0; policy drop;
          ct state established,related accept

          # Salida a Internet (enp1s0) desde todas las VLANs
          iifname { "enp2s0", "enp3s0", "enp4s0", "enp5s0" } oifname "enp1s0" accept

          # VLAN 10 (MGMT) tiene acceso total a todas las VLANs para administrar
          iifname "enp2s0" oifname { "enp3s0", "enp4s0", "enp5s0" } accept

          # VLAN 20 (LAN) puede acceder a la DMZ (VLAN 30) y a servicios de directorio/monit en VLAN 10 (DNS/LDAP)
          iifname "enp3s0" oifname "enp4s0" accept
          iifname "enp3s0" oifname "enp2s0" tcp dport { 53, 88, 389, 443, 636 } accept
          iifname "enp3s0" oifname "enp2s0" udp dport { 53, 88, 123 } accept

          # VLAN 30 (DMZ) puede consultar LDAP/DNS en VLAN 10 si fuera necesario, pero NUNCA iniciar conexión a LAN o MGMT
          iifname "enp4s0" oifname "enp2s0" tcp dport { 53, 389, 636 } accept
          iifname "enp4s0" oifname "enp2s0" udp dport 53 accept

          # VLAN 40 (GUEST): policy drop bloquea cualquier acceso a VLAN 10, 20 y 30 (solo tiene Internet arriba)
        }

        chain output {
          type filter hook output priority 0; policy accept;
        }
      }

      table ip nat {
        chain postrouting {
          type nat hook postrouting priority 100; policy accept;
          oifname "enp1s0" masquerade
        }
      }

runcmd:
  - sysctl --system
  - systemctl enable --now nftables
